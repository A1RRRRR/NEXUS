# TikTok Developer App Credentials (get from developers.tiktok.com)
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here

# Redirect URI registered in your TikTok developer app
TIKTOK_REDIRECT_URI=http://localhost:8080/callback

# Optional: ElevenLabs API for high-quality AI voice (free tier available)
ELEVENLABS_API_KEY=

# Optional: OpenAI for script generation
OPENAI_API_KEY=

# Database path
DB_PATH=data/nexus.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/nexus.log
